# CertiCheck backend — copy to .env and fill in. Never commit .env.
# Railway: paste these into the service Variables tab instead.

# Server
PORT=3001
NODE_ENV=production

# Public URLs (no trailing slash)
APP_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Database — Railway: mount a Volume at /data, then use file:/data/certicheck.db
DATABASE_URL=file:./prisma/certicheck.db

# Uploads — Railway: point at the volume so files survive restarts, e.g. /data/uploads
UPLOAD_DIR=./uploads

# Auth / sessions
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
# Split-domain prod (Render): frontend + API on different hosts need "none".
# Local dev stays "lax".
COOKIE_SAMESITE=lax
ADMIN_INVITE_CODE=change-me
REQUIRE_EMAIL_VERIFICATION=false

# 2FA — REQUIRED to start 2FA. Generate: 64 hex chars (32 random bytes).
# PowerShell: (-join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) }))
TOTP_ENCRYPTION_KEY=

# Email (optional — verification + reset mails are skipped without SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CertiCheck <no-reply@certicheck.local>

# Password-breach check (optional, on by default)
HIBP_ENABLED=true
HIBP_STRICT=false

# Rate limits (requests per window)
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20
TOTP_RATE_LIMIT=5

# OCR
OCR_WORKERS=2
# Directory holding eng.traineddata. Deploy builds download it here so cold
# starts never wait on it. Local dev: leave unset (auto-fetch on first use).
TESSERACT_LANG_PATH=./lang-data

# Sepolia anchoring (optional — app runs with the chain DISABLED if unset)
CHAIN_RPC_URL=
CHAIN_SIGNER_KEY=
CONTRACT_ADDRESS=
CHAIN_RPC_TIMEOUT_MS=8000
CHAIN_SUBMIT_TIMEOUT_MS=45000
CHAIN_CONFIRMATIONS=1
